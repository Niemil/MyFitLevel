<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView android:id="@+id/w_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/w_bg_m" />
    <LinearLayout android:id="@+id/w_content" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:padding="4dp" android:gravity="center_vertical">
        <LinearLayout android:id="@+id/a_log" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/a_log_e" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="22sp" android:textColor="#FFFFFF" android:text="➕" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/a_log_t" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#FFFFFF" android:text="Log" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="2dp"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/a_feed" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/a_feed_e" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="22sp" android:textColor="#FFFFFF" android:text="📰" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/a_feed_t" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#FFFFFF" android:text="Feed" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="2dp"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/a_boss" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/a_boss_e" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="22sp" android:textColor="#FFFFFF" android:text="🏆" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/a_boss_t" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#FFFFFF" android:text="Boss" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="2dp"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/a_steps" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/a_steps_e" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="22sp" android:textColor="#FFFFFF" android:text="👟" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/a_steps_t" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#FFFFFF" android:text="Steps" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="2dp"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/a_chest" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/a_chest_e" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="22sp" android:textColor="#FFFFFF" android:text="🎁" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/a_chest_t" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#FFFFFF" android:text="Chest" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="2dp"/>
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/w_msg" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:padding="12dp" android:textSize="13sp" android:textStyle="bold" android:textColor="#FFFFFF" android:visibility="gone" />
    <LinearLayout android:id="@+id/w_tools" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|end" android:layout_margin="4dp" android:orientation="horizontal">
        <TextView android:id="@+id/w_updated" android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="4dp" android:textSize="9sp" android:textColor="#99FFFFFF" android:text="⟳" />
        <TextView android:id="@+id/w_cfg" android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="4dp" android:textSize="10sp" android:textColor="#99FFFFFF" android:text="⚙" />
    </LinearLayout>
</FrameLayout>
