<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView android:id="@+id/w_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/w_bg_m" />
    <LinearLayout android:id="@+id/w_content" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:padding="10dp" android:gravity="center_vertical">
        <FrameLayout android:layout_width="54dp" android:layout_height="54dp">
            <ImageView android:id="@+id/l_ring" android:layout_width="54dp" android:layout_height="54dp" android:scaleType="fitXY" />
            <TextView android:id="@+id/l_lvl" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="17sp" android:textColor="#FFFFFF" android:text="26" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:layout_gravity="center"/>
        </FrameLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:orientation="vertical">
            <TextView android:id="@+id/l_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="14sp" android:textColor="#FFFFFF" android:text="Your name" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:layout_marginEnd="44dp"/>
            <TextView android:id="@+id/l_xp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#FFFFFF" android:text="53,065 points" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/l_next" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#FFFFFF" android:text="3,185 points to level 27" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/w_msg" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:padding="12dp" android:textSize="13sp" android:textStyle="bold" android:textColor="#FFFFFF" android:visibility="gone" />
    <LinearLayout android:id="@+id/w_tools" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|end" android:layout_margin="4dp" android:orientation="horizontal">
        <TextView android:id="@+id/w_updated" android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="4dp" android:textSize="9sp" android:textColor="#99FFFFFF" android:text="⟳" />
        <TextView android:id="@+id/w_cfg" android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="4dp" android:textSize="10sp" android:textColor="#99FFFFFF" android:text="⚙" />
    </LinearLayout>
</FrameLayout>
