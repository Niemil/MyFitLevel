<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView android:id="@+id/w_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/w_bg_m" />
    <LinearLayout android:id="@+id/w_content" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp">
        <TextView android:id="@+id/s_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#FFFFFF" android:text="👟 Steps today" android:maxLines="1" android:ellipsize="end" android:layout_marginEnd="44dp"/>
        <TextView android:id="@+id/s_big" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="32sp" android:textColor="#FFFFFF" android:text="8,200" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
        <ImageView android:id="@+id/s_bar" android:layout_width="match_parent" android:layout_height="10dp" android:scaleType="fitXY" android:layout_marginTop="4dp"/>
        <TextView android:id="@+id/s_sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#FFFFFF" android:text="of 10,000 · 6.1 km" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="6dp"/>
        <TextView android:id="@+id/s_yest" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#FFFFFF" android:text="Yesterday 17,000" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/s_stat" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#FFFFFF" android:text="✓ Synced 05:25" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="4dp"/>
    </LinearLayout>
    <TextView android:id="@+id/w_msg" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:padding="12dp" android:textSize="13sp" android:textStyle="bold" android:textColor="#FFFFFF" android:visibility="gone" />
    <LinearLayout android:id="@+id/w_tools" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|end" android:layout_margin="4dp" android:orientation="horizontal">
        <TextView android:id="@+id/w_updated" android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="4dp" android:textSize="9sp" android:textColor="#99FFFFFF" android:text="⟳" />
        <TextView android:id="@+id/w_cfg" android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="4dp" android:textSize="10sp" android:textColor="#99FFFFFF" android:text="⚙" />
    </LinearLayout>
</FrameLayout>
